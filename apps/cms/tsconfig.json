{
  "compilerOptions": {
    "target": "ES2022", "lib": ["DOM", "ES2022"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "preserve", "strict": true, "skipLibCheck": true, "noEmit": true, "esModuleInterop": true,
    "resolveJsonModule": true, "isolatedModules": true, "incremental": true, "allowJs": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@payload-config": ["./src/payload.config.ts"] }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
